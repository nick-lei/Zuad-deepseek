{
  "name": "dsh-plugin-zuad-media",
  "version": "0.1.0",
  "license": "Unlicense",
  "description": "用对话制作节目、管理素材、安排播放与操作设备的 Zuad 信发助手。",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nick-lei/Zuad-deepseek.git"
  },
  "homepage": "https://github.com/nick-lei/Zuad-deepseek#readme",
  "bugs": {
    "url": "https://github.com/nick-lei/Zuad-deepseek/issues"
  },
  "keywords": ["deepseek-harness", "dsh", "zuad", "digital-signage"],
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./client": "./client/index.js",
    "./package.json": "./package.json",
    "./locale/*": "./locale/*"
  },
  "files": [
    "lib",
    "client",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "docs/development.md",
    "locale"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=24.9.0",
    "dsh": "0.2.1-rc.5 || 0.2.2-alpha.2"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "coverage:api": "npm run build && node scripts/plugin-coverage.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.5",
    "@napi-rs/canvas": "^1.1.0",
    "fetch-cookie": "^3.1.0",
    "jquery": "^3.7.1",
    "jsdom": "^30.1.3",
    "qrcode": "^1.5.4",
    "tough-cookie": "^5.1.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5 || 4.0.6-alpha.1",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5 || 0.2.2-alpha.2"
  },
  "devDependencies": {
    "playwright-core": "^1.58.0",
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5",
    "@types/jquery": "^4.0.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
