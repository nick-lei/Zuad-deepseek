{
  "name": "dsh-plugin-zuad-media",
  "version": "0.1.2",
  "license": "Unlicense",
  "description": "用对话制作节目、管理素材、安排播放与操作设备的 Zuad 信发助手。",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nick-lei/Zuad-deepseek.git"
  },
  "homepage": "https://github.com/nick-lei/Zuad-deepseek#readme",
  "bugs": {
    "url": "https://github.com/nick-lei/Zuad-deepseek/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "zuad",
    "digital-signage"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "bin": { "zuad-media-mcp": "./lib/mcp.js", "zuad-signage-mcp": "./lib/mcp/stdio.js", "zuad-signage-connect": "./lib/mcp/connect.js", "zuad-media-connect": "./lib/connect.js" },
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./client": "./client/index.js",
    "./mcp": "./lib/mcp.js",
    "./core": { "types": "./lib/core/index.d.ts", "import": "./lib/core/index.js" },
    "./mcp/server": "./lib/mcp/server.js",
    "./package.json": "./package.json",
    "./locale/*": "./locale/*"
  },
  "files": [
    "lib",
    "client",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "docs/development.md",
    "docs/plugin-details.*.md",
    "locale",
    "skills",
    "codex",
    "adapters",
    "scripts/install-codex.mjs",
    "scripts/build-platforms.mjs",
    "scripts/package-platforms.mjs",
    "scripts/npm.mjs",
    "scripts/build-dsh.mjs",
    "docs/codex.md",
    "docs/platforms.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=24.15.0",
    "dsh": "0.2.1-rc.2 || 0.2.1-rc.5 || 0.2.2-alpha.2"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-dsh.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build && npm run verify:dsh",
    "verify:dsh": "node scripts/verify-dsh-bundle.mjs",
    "coverage:api": "npm run build && node scripts/plugin-coverage.mjs",
    "prepack": "npm run build",
    "start:mcp": "node lib/mcp.js",
    "install:codex": "node scripts/install-codex.mjs",
    "connect:codex": "node lib/connect.js",
    "build:platforms": "npm run build && node scripts/build-platforms.mjs",
    "package:platforms": "npm run build && node scripts/package-platforms.mjs",
    "verify:platforms": "node scripts/verify-platforms.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.5",
    "@modelcontextprotocol/sdk": "1.32.2",
    "ajv": "8.20.0",
    "@napi-rs/canvas": "^1.1.0",
    "fetch-cookie": "^3.1.0",
    "jquery": "^3.7.1",
    "jsdom": "^30.1.3",
    "qrcode": "^1.5.4",
    "tough-cookie": "^5.1.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5 || 4.0.6-alpha.1",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2 || 0.2.1-rc.5 || 0.2.2-alpha.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.2 || 0.2.1-rc.5 || 0.2.2-alpha.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.5",
    "@types/jquery": "^4.0.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "playwright-core": "^1.58.0",
    "esbuild": "0.28.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
